<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Honer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/honer_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Honer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/honer_icon_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Honer</item>
    </style>
</resources>
