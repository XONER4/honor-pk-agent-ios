# ---- обязательные ----
# Postgres (Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://user:password@host:5432/railway
# DATABASE_SSL=true            # включить, если подключаетесь к Postgres через публичный прокси с TLS
# Ключ DeepSeek (никогда не попадает в клиенты и логи)
DEEPSEEK_API_KEY=sk-...
# Вход админа по ключу (fallback, пока не настроен Google). Длинная случайная строка!
ADMIN_KEY=change-me-to-a-long-random-string
# Кому разрешён вход через Google (через запятую, регистр не важен)
ADMIN_EMAILS=admin@example.com
# OAuth client ID(s), которыми подписаны Google ID token админ-приложения (через запятую)
GOOGLE_CLIENT_IDS=1234567890-xxxx.apps.googleusercontent.com
# Путь, куда смонтирован том Railway (в Docker-образе по умолчанию /data/media)
MEDIA_DIR=/data/media

# ---- необязательные ----
# JSON сервисного аккаунта Firebase (сырой JSON или base64) — включает FCM push
# FIREBASE_SERVICE_ACCOUNT=
# PORT=3000                    # Railway задаёт сам
# LOG_LEVEL=info
# CORS_ORIGINS=                # по умолчанию CORS закрыт; через запятую для веб-клиентов
# MAX_UPLOAD_BYTES=104857600   # 100 МБ
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI_ALLOWED_MODELS=deepseek-flash,deepseek-chat,deepseek-reasoner
# AI_GROUP_MODEL=deepseek-flash
# AI_RATE_MAX=60               # запросов к AI-прокси на устройство за окно
# AI_RATE_WINDOW_MS=600000     # 10 минут
# AI_QUESTION_DELAY_MS=20000   # сколько ждать ответа админа на вопрос, прежде чем ответит ИИ
# AI_HISTORY_LIMIT=30
# PRESENCE_OFFLINE_MS=40000    # offline после 40 с без сокета
# TYPING_TTL_MS=8000
# WS_IDLE_MS=75000             # закрыть сокет без кадров дольше этого
# LOGIN_RATE_MAX=10            # неудачных входов админа с одного IP за окно
# LOGIN_RATE_WINDOW_MS=900000
# REGISTER_RATE_MAX=60
# REGISTER_RATE_WINDOW_MS=600000
# ADMIN_TOKEN_TTL_MS=15552000000  # 180 дней
# TRUST_PROXY=true             # за прокси Railway — true (реальный IP из X-Forwarded-For)
# DB_MODE=memory               # только для локальной разработки (нужны devDependencies)
